# Copy to .env (git-ignored). Or store these in the macOS Keychain via `lcp` helpers.
# NEVER commit real secrets. Only the keys you actually use need values.

# --- LinkedIn (StaffSpy / linkedin-mcp use your own logged-in browser session;
#     prefer the session_file / browser login over storing a raw password) ---
LINKEDIN_USERNAME=__SET_ME__
LINKEDIN_PASSWORD=__SET_ME__

# --- Proxies (only if proxies.backend != none) ---
WEBSHARE_PROXY_USER=__SET_ME__
WEBSHARE_PROXY_PASS=__SET_ME__
WEBSHARE_PROXY_HOST=__SET_ME__

# --- Captcha solver (only if people.staffspy.captcha_solver != none) ---
CAPTCHA_SOLVER_API_KEY=__SET_ME__

# --- Job board supplement (only if jobs.adzuna.enabled) ---
ADZUNA_APP_ID=__SET_ME__
ADZUNA_APP_KEY=__SET_ME__

# --- Enrichment (only if enrichment.mode == python; MCP mode uses Claude Desktop OAuth) ---
APOLLO_API_KEY=__SET_ME__
PROSPEO_API_KEY=__SET_ME__
KASPR_API_KEY=__SET_ME__
HUNTER_API_KEY=__SET_ME__
