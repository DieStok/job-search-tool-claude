# Normalize line endings on commit; let git choose checkout endings per the rules below.
* text=auto

# Force LF for shell, Python, YAML, JSON, and Markdown files.
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Force CRLF for Windows scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no line-ending conversion.
*.parquet binary
*.png     binary
